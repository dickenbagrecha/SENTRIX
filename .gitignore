# SENTRIX Unified Security Platform .gitignore

# Compiled Binaries & Build Output
/bin/
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.o
*.obj

# Build Directories & Artifacts
build/
dist/
.cache/
*.out
*.tar
*.tar.gz

# Secrets, Environment Files & Keys
.env
.env.local
.env.*.local
*.secret
credentials.json
token.json
local_api_credentials.yaml

# Node & Package Managers
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test Artifacts & Logs
*.log
eval_result.json
coverage.txt
profile.cov

# Temporary, OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
scratch/
tmp/
