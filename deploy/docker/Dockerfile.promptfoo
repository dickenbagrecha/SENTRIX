# Multi-stage Docker build for Promptfoo AI Security Toolkit
FROM node:22-alpine AS builder

WORKDIR /app

COPY engines/promptfoo-main/package*.json engines/promptfoo-main/tsconfig*.json ./
COPY engines/promptfoo-main/ ./

# Build TypeScript distributions
RUN npm install --legacy-peer-deps && npm run build

# Runtime Stage
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PROMPTFOO_DISABLE_TELEMETRY=true

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 15500

ENTRYPOINT ["node", "dist/src/entrypoint.js"]
CMD ["view", "--port", "15500", "--host", "0.0.0.0"]
