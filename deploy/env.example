# ==============================================================================
# SENTRIX Environment Configuration Template
# Copy to deploy/.env and configure values before starting services
# ==============================================================================

# Core Configuration
SENTRIX_ENV=development
SENTRIX_HTTP_PORT=9000
SENTRIX_LOG_LEVEL=info
SENTRIX_LOG_FORMAT=json

# Coraza Ingress WAF
WAF_LISTEN_ADDR=:8080
BACKEND_URL=http://sentrix-core:9000
WAF_MODE=DetectionOnly

# CrowdSec Settings
CROWDSEC_BOUNCER_KEY=sentrix_dev_bouncer_key_change_me
DISABLE_ONLINE_API=true

# Promptfoo Settings
PROMPTFOO_DISABLE_TELEMETRY=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Wazuh Manager Credentials
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=Wazuh-Secret-Password-123!
